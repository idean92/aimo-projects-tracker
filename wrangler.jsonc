{
  "name": "aimo-projects-tracker",
  // Update to today's date if Wrangler complains this is stale.
  "compatibility_date": "2026-08-01",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aimo-projects-tracker-db",
      "database_id": "89e58d3c-7182-4b2f-96c7-7b15d8bdbf18"
    }
  ]
}
